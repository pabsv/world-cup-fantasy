# Copy to .env.local and fill in. NEVER commit real values.

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Server-only secret (service/secret key) ---
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Migrations / scripts only (server-side direct Postgres) ---
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_PROJECT_REF=YOUR_REF
SUPABASE_DB_REGION=eu-central-1
